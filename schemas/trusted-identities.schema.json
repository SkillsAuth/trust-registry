{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsauth.com/schemas/trusted-identities.schema.json",
  "title": "Trusted identities",
  "type": "object",
  "required": [
    "version",
    "updatedAt",
    "owner",
    "issuer",
    "identities"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^1\\.0$" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "owner": { "type": "string", "minLength": 1 },
    "issuer": {
      "type": "string",
      "const": "https://token.actions.githubusercontent.com"
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "repository",
          "workflow",
          "ref",
          "subjectAlternativeName",
          "sourceRepositoryOwner",
          "allowSelfHostedRunner",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "workflow": {
            "type": "string",
            "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.yml$"
          },
          "ref": {
            "type": "string",
            "pattern": "^refs/(heads|tags)/[A-Za-z0-9._/-]+$"
          },
          "subjectAlternativeName": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\\.github/workflows/[A-Za-z0-9_.-]+\\.yml@refs/(heads|tags)/[A-Za-z0-9._/-]+$"
          },
          "sourceRepositoryOwner": { "type": "string", "minLength": 1 },
          "allowSelfHostedRunner": { "type": "boolean" },
          "status": { "type": "string", "enum": ["active", "disabled"] }
        }
      }
    }
  }
}

